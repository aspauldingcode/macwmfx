{
  "theme": "Liquid Glass",
  "global": {
    "geometry": {
      "cornerRadius": 18.0,
      "asymmetricRadius": {
        "topLeft": 18.0,
        "topRight": 18.0,
        "bottomLeft": 0.0,
        "bottomRight": 0.0
      },
      "margins": {
        "top": 10,
        "bottom": 10,
        "left": 10,
        "right": 10
      },
      "contentPadding": 8.0
    },
    "materials": {
      "vibrancy": "ultra-thin",
      "blurRadius": 40.0,
      "opacity": 0.95,
      "tint": "#ffffff",
      "saturation": 1.2,
      "noise": 0.02
    },
    "decoration": {
      "border": {
        "enabled": true,
        "thickness": 1.5,
        "material": "frosted",
        "gradient": [
          {
            "color": "#ffffff",
            "offset": 0.0
          },
          {
            "color": "#cccccc",
            "offset": 1.0
          }
        ],
        "glow": {
          "radius": 5.0,
          "color": "rgba(255, 255, 255, 0.3)",
          "animated": true
        }
      },
      "shadow": {
        "enabled": true,
        "radius": 40.0,
        "noise": 0.05,
        "stacks": [
          {
            "radius": 10.0,
            "offset": [
              0,
              5
            ],
            "opacity": 0.2
          },
          {
            "radius": 40.0,
            "offset": [
              0,
              20
            ],
            "opacity": 0.1
          }
        ]
      }
    },
    "chrome": {
      "titlebar": {
        "style": "unified",
        "height": 38.0,
        "transparent": true,
        "floating": true,
        "detached": false
      },
      "trafficLights": {
        "position": [
          12.0,
          12.0
        ],
        "scale": 1.1,
        "spacing": 8.0,
        "customGlyphs": false
      }
    },
    "motion": {
      "animations": {
        "open": {
          "type": "scale-fade",
          "duration": 0.3,
          "easing": "spring"
        },
        "resize": {
          "type": "elastic",
          "damping": 0.8,
          "stiffness": 200
        }
      }
    }
  },
  "rules": [
    {
      "match": {
        "bundleIdentifier": "com.apple.Terminal"
      },
      "override": {
        "materials": {
          "vibrancy": "dark",
          "blurRadius": 60.0
        },
        "decoration": {
          "border": {
            "gradient": [
              {
                "color": "#00ff00",
                "offset": 0.0
              }
            ]
          }
        }
      }
    },
    {
      "match": {
        "state": "inactive"
      },
      "override": {
        "materials": {
          "saturation": 0.5,
          "opacity": 0.8
        },
        "decoration": {
          "shadow": {
            "radius": 10.0
          }
        }
      }
    }
  ]
}